<div class="panel-error-404">
    <div class="codigo-error">404</div>
    <h1 class="titulo-error">
        <%= titulo %>
    </h1>
    <p class="mensaje-error-desc">
        <%= mensaje %>
    </p>

    <div class="sugerencia-error">
        <p>Verificá la URL ingresada o navegá por los enlaces disponibles:</p>
        <div class="acciones-error">
            <a href="/" class="boton boton-primario">Ir al Inicio</a>
            <a href="/reservas" class="boton boton-secundario">Ver Reservas Activas</a>
            <a href="/reservas/nueva" class="boton boton-enlace">Registrar Turno</a>
        </div>
    </div>
</div>