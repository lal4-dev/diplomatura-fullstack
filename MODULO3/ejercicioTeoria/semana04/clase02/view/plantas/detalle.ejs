<article>
    <p class="etiqueta">
        <%= planta.tipo %>
    </p>
    <h1>
        <%= planta.nombre %>
    </h1>

    <dl>
        <dt>Luz</dt>
        <dd>
            <%= planta.luz %>
        </dd>
        <dt>Riego</dt>
        <dd>
            <%= planta.riego %>
        </dd>
    </dl>
    <p>
        <%= planta.descripcion %>
    </p>
    <a href="/plantas"> Volver al catalogo</a>
</article>